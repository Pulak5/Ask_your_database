# Ask Your Database - configuration
# Copy to .env and fill in. Never commit .env.

# --- Database (local docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=ask_your_db
DATABASE_URL=postgresql://app:app_password@localhost:5432/ask_your_db
# Read-only role used by the application at runtime
APP_READONLY_USER=app_readonly
APP_READONLY_PASSWORD=app_readonly_password

# --- LLM backend ---
# one of: mock | openai_compat | bedrock
LLM_BACKEND=mock
# OpenAI-compatible backend (e.g. vLLM server)
OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
OPENAI_COMPAT_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# AWS Bedrock backend
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# For local dev only; prefer IAM roles / instance profiles in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
STREAMLIT_SERVER_PORT=8501
MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=5

# --- Training / eval (Phase 2) ---
HF_HOME=~/.cache/huggingface
HF_TOKEN=
WANDB_API_KEY=
TRAIN_OUTPUT_DIR=./outputs
SEED=15